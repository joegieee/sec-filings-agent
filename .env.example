# Copy to .env and fill in. SEC fair-access policy requires a contact email.
FRA_SEC_USER_AGENT="filings-agent your.name@example.com"

# Optional overrides (defaults shown)
# FRA_DATA_DIR=data
# FRA_COMPANIES_FILE=config/companies.toml
# FRA_SEC_MAX_REQUESTS_PER_SECOND=5
# FRA_HTTP_TIMEOUT_SECONDS=30
# FRA_HTTP_MAX_RETRIES=5
# FRA_LOOKBACK_YEARS=3

# LLM for extraction and questions. Default: Gemini via a Google AI Studio key
# (https://aistudio.google.com/apikey). No key at all: FRA_LLM_PROVIDER=ollama.
GEMINI_API_KEY=""
# FRA_LLM_PROVIDER=gemini        # gemini | ollama | openai_compatible | anthropic
# FRA_LLM_MODEL=                 # default per provider: gemini-3.8-flash, qwen3:8b, claude-opus-5-5
# FRA_LLM_EFFORT=                # low | medium | high (| xhigh | max for Claude); provider default if unset
# FRA_LLM_CACHE=true             # matching responses are reused from data/cache/llm
# FRA_LLM_DAILY_LIMIT=           # generate calls/day; retries may send more; default 20 for gemini
# FRA_LLM_PRICE_INPUT=           # USD per million tokens, for cost reports (both or neither)
# FRA_LLM_PRICE_OUTPUT=

# Ollama (local, no key): `ollama pull qwen3:8b` then `ollama serve`
# FRA_OLLAMA_NUM_CTX=16384       # context window; increase if prompts do not fit
# FRA_OLLAMA_THINK=false         # disable thinking to reduce local generation time

# Any other OpenAI-compatible API (OpenRouter, DeepSeek, Groq, OpenCode Go...)
# FRA_LLM_PROVIDER=openai_compatible
# FRA_LLM_BASE_URL=https://openrouter.ai/api/v1
# FRA_LLM_MODEL=qwen/qwen3-235b-a22b
# FRA_LLM_API_KEY=

# Claude (paid API)
# ANTHROPIC_API_KEY=
